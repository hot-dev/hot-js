{
  "name": "@hot-dev/sdk",
  "version": "1.0.0",
  "description": "JavaScript/TypeScript SDK for the Hot Dev API",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./streaming": {
      "types": "./dist/streaming/index.d.ts",
      "import": "./dist/streaming/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./webhook": {
      "types": "./dist/webhook/index.d.ts",
      "import": "./dist/webhook/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy/index.d.ts",
      "import": "./dist/proxy/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prepare": "tsup",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "update:openapi-fixture": "node scripts/update-openapi-operations.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hot-dev/hot-js",
    "directory": "packages/sdk"
  },
  "homepage": "https://hot.dev",
  "keywords": [
    "hot",
    "hot-dev",
    "sdk",
    "api",
    "agents",
    "streaming"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  }
}
